# Stage 1: Build & Publish
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY contracts/grpc/catalog_stock.proto contracts/grpc/
COPY src/Services/Shop.OrderService/Shop.OrderService.csproj src/Services/Shop.OrderService/

RUN dotnet restore src/Services/Shop.OrderService/Shop.OrderService.csproj

COPY src/Services/Shop.OrderService/ src/Services/Shop.OrderService/

RUN dotnet publish src/Services/Shop.OrderService/Shop.OrderService.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Shop.OrderService.dll"]
