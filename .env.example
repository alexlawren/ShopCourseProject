# ==============================================================================
# ShopCourseProject — Environment Configuration Template (.env.example)
# Copy this file to .env and provide appropriate values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Compose Configuration
# ------------------------------------------------------------------------------

# PostgreSQL Credentials (used by Docker Compose postgres container)
POSTGRES_USER=shop
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Signing Key (shared between IdentityService, CatalogService, and OrderService)
# Minimum 32 characters (256 bits) for HMAC-SHA256
JWT_KEY=your_secure_jwt_secret_key_minimum_32_characters_long_2026

# Gateway Host Port (external port exposed to the browser)
GATEWAY_PORT=8080

# Optional: Initial Bootstrap Administrator Account
# If configured, IdentityService creates/elevates this user to the Admin role on startup.
BOOTSTRAP_ADMIN_EMAIL=admin@shop.local
BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# 2. Local Development Overrides (Non-Docker dotnet run)
# ------------------------------------------------------------------------------
# Note: double underscore (__) maps to colon (:) in ASP.NET Core configuration,
# e.g. ConnectionStrings__IdentityDb = ConnectionStrings:IdentityDb
#
# ConnectionStrings__IdentityDb=Host=localhost;Port=5432;Database=shop_identity;Username=postgres;Password=your_password
# ConnectionStrings__CatalogDb=Host=localhost;Port=5432;Database=shop_catalog;Username=postgres;Password=your_password
# ConnectionStrings__OrderDb=Host=localhost;Port=5432;Database=shop_orders;Username=postgres;Password=your_password
# Jwt__Key=your_development_jwt_secret_key_minimum_32_characters