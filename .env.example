# PostgreSQL (used by Docker Compose)
POSTGRES_USER=
POSTGRES_PASSWORD=

# Connection strings for ASP.NET Core services
# Note: double underscore (__) maps to colon (:) in ASP.NET Core configuration,
# e.g. ConnectionStrings__IdentityDb = ConnectionStrings:IdentityDb
ConnectionStrings__IdentityDb=
ConnectionStrings__CatalogDb=
ConnectionStrings__OrderDb=

# Authentication (Jwt__Key maps to Jwt:Key in ASP.NET Core)
Jwt__Key=

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Gateway ReverseProxy Cluster Destinations
ReverseProxy__Clusters__identity-cluster__Destinations__identity-destination__Address=http://localhost:5078/
ReverseProxy__Clusters__catalog-cluster__Destinations__catalog-destination__Address=http://localhost:5058/
ReverseProxy__Clusters__order-cluster__Destinations__order-destination__Address=http://localhost:5141/