# PostgreSQL (used by Docker Compose)
POSTGRES_USER=
POSTGRES_PASSWORD=

# Connection strings for ASP.NET Core services
# Note: double underscore (__) maps to colon (:) in ASP.NET Core configuration,
# e.g. ConnectionStrings__IdentityDb = ConnectionStrings:IdentityDb
ConnectionStrings__IdentityDb=
ConnectionStrings__CatalogDb=
ConnectionStrings__OrderDb=

# Authentication
JWT_KEY=

# Environment
ASPNETCORE_ENVIRONMENT=Development