{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://localhost:5058",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5059",
        "Protocols": "Http2"
      }
    }
  },
  "Jwt": {
    "Issuer": "ShopCourseProject.Identity",
    "Audience": "ShopCourseProject.Client"
  },
  "ProductImages": {
    "StoragePath": "data/product-images",
    "RequestPath": "/product-images",
    "MaxFileSizeBytes": 5242880
  }
}
