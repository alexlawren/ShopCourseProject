{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "product-images-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/product-images/{**catch-all}"
        }
      },
      "catalog-hub-base": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/hubs/catalog"
        }
      },
      "catalog-hub-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/hubs/catalog/{**catch-all}"
        }
      },
      "cart-base": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/cart"
        }
      },
      "cart-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "orders-base": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders"
        }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "admin-orders-base": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/admin/orders"
        }
      },
      "admin-orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/admin/orders/{**catch-all}"
        }
      },
      "order-hub-base": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/hubs/orders"
        }
      },
      "order-hub-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/hubs/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://localhost:5078/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://localhost:5058/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://localhost:5141/"
          }
        }
      }
    }
  }
}
