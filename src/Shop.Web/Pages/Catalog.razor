@page "/catalog"
@inject ICatalogApiClient CatalogClient
@inject ICartApiClient CartClient
@inject ICatalogRealtimeService RealtimeService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Каталог товаров - ShopCourseProject</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">Каталог товаров</h2>
        <span class="badge bg-light text-dark border">
            Реальное время:
            @if (RealtimeService.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
            {
                <span class="text-success fw-bold">● Подключено</span>
            }
            else
            {
                <span class="text-muted">Подключение...</span>
            }
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_cartFeedbackMessage))
    {
        <div class="alert @(_cartFeedbackIsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 mb-3" role="alert">
            @_cartFeedbackMessage
            <button type="button" class="btn-close" @onclick="() => _cartFeedbackMessage = null"></button>
        </div>
    }

    <!-- Фильтры -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-light">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="searchQuery" class="form-label small fw-semibold">Поиск</label>
                <input id="searchQuery" type="text" class="form-control form-control-sm" placeholder="Название или описание..." @bind="_query.Search" />
            </div>

            <div class="col-md-2">
                <label for="categoryFilter" class="form-label small fw-semibold">Категория</label>
                <select id="categoryFilter" class="form-select form-select-sm" @bind="_selectedCategoryIdString">
                    <option value="">Все категории</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id.ToString()">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label for="minPriceInput" class="form-label small fw-semibold">Цена от</label>
                <input id="minPriceInput" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="0.00" @bind="_query.MinPrice" />
            </div>

            <div class="col-md-2">
                <label for="maxPriceInput" class="form-label small fw-semibold">Цена до</label>
                <input id="maxPriceInput" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="99999.00" @bind="_query.MaxPrice" />
            </div>

            <div class="col-md-3">
                <label for="sortFilter" class="form-label small fw-semibold">Сортировка</label>
                <select id="sortFilter" class="form-select form-select-sm" @bind="_query.Sort">
                    <option value="newest">Сначала новые</option>
                    <option value="priceAsc">Сначала дешевле</option>
                    <option value="priceDesc">Сначала дороже</option>
                    <option value="nameAsc">По названию (А-Я)</option>
                    <option value="nameDesc">По названию (Я-А)</option>
                </select>
            </div>

            <div class="col-12 d-flex justify-content-between align-items-center pt-2 border-top">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="inStockCheck" @bind="_query.InStock" />
                    <label class="form-check-label small" for="inStockCheck">
                        Только в наличии
                    </label>
                </div>

                <div>
                    <button class="btn btn-outline-secondary btn-sm me-2" @onclick="HandleResetFilters">Сбросить</button>
                    <button class="btn btn-primary btn-sm px-3" @onclick="HandleApplyFilters">Применить</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Список товаров -->
    @if (_isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-muted mt-2">Загрузка товаров...</p>
        </div>
    }
    else if (_products.Items.Count == 0)
    {
        <div class="text-center my-5 py-5 bg-white rounded shadow-sm">
            <h4 class="text-muted">Товары не найдены</h4>
            <p class="text-muted small">Попробуйте изменить параметры поиска или фильтры.</p>
            <button class="btn btn-outline-primary btn-sm" @onclick="HandleResetFilters">Сбросить фильтры</button>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var prod in _products.Items)
            {
                <div class="col" @key="prod.Id">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="product-img-container bg-light d-flex align-items-center justify-content-center p-2" style="height: 180px;">
                            @if (!string.IsNullOrWhiteSpace(prod.ImagePath))
                            {
                                <img src="@CatalogClient.GetImageUrl(prod.ImagePath)" class="img-fluid mh-100 rounded" alt="@prod.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="text-muted text-center">
                                    <svg width="48" height="48" fill="currentColor" class="bi bi-image text-secondary" viewBox="0 0 16 16">
                                        <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                                        <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    <div class="small mt-1">Нет фото</div>
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary-subtle text-secondary small align-self-start mb-1">
                                @(string.IsNullOrWhiteSpace(prod.CategoryName) ? "Без категории" : prod.CategoryName)
                            </span>
                            <h6 class="card-title fw-bold text-dark mb-2 text-truncate" title="@prod.Name">
                                <a href="/products/@prod.Id" class="text-decoration-none text-dark">
                                    @prod.Name
                                </a>
                            </h6>

                            <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                                <div class="fw-bold fs-5 text-primary">
                                    @prod.Price.ToString("F2") ₽
                                </div>
                                <div>
                                    @if (prod.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" title="Количество на складе">
                                            @prod.StockQuantity шт.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            Нет
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="mt-2">
                                <AuthorizeView>
                                    <Authorized>
                                        @if (prod.StockQuantity > 0)
                                        {
                                            <button class="btn btn-primary btn-sm w-100" @onclick="() => HandleAddToCart(prod.Id)" disabled="@_isAddingToCart">
                                                @(_justAddedProductId == prod.Id ? "✓ Добавлено" : "В корзину")
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                                Нет в наличии
                                            </button>
                                        }
                                    </Authorized>
                                    <NotAuthorized>
                                        <a href="/login" class="btn btn-outline-secondary btn-sm w-100">
                                            Войдите, чтобы купить
                                        </a>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Пагинация -->
        @if (_products.TotalPages > 1)
        {
            <div class="d-flex justify-content-center align-items-center mt-5 gap-3">
                <button class="btn btn-outline-secondary btn-sm" disabled="@(_query.Page <= 1)" @onclick="() => ChangePage(_query.Page - 1)">
                    ← Назад
                </button>
                <span class="small text-muted">
                    Страница <strong>@_products.Page</strong> из <strong>@_products.TotalPages</strong> (всего: @_products.TotalItems)
                </span>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(_query.Page >= _products.TotalPages)" @onclick="() => ChangePage(_query.Page + 1)">
                    Вперёд →
                </button>
            </div>
        }
    }
</div>

@code {
    private readonly CatalogQueryModel _query = new() { PageSize = 12 };
    private PagedResultDto<ProductListItemDto> _products = new();
    private IReadOnlyList<CategoryDto> _categories = [];
    private string _selectedCategoryIdString = "";
    private bool _isLoading = true;
    private bool _isAddingToCart = false;
    private Guid? _justAddedProductId;
    private string? _cartFeedbackMessage;
    private bool _cartFeedbackIsError;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to real-time events
        RealtimeService.OnStockChanged += HandleStockChanged;
        RealtimeService.OnProductChanged += HandleProductChanged;
        await RealtimeService.StartAsync();

        // Load categories and initial products
        _categories = await CatalogClient.GetCategoriesAsync();
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        if (Guid.TryParse(_selectedCategoryIdString, out var catId))
        {
            _query.CategoryId = catId;
        }
        else
        {
            _query.CategoryId = null;
        }

        _products = await CatalogClient.GetProductsAsync(_query);
        _isLoading = false;
        StateHasChanged();
    }

    private async Task HandleApplyFilters()
    {
        _query.Page = 1;
        await LoadProductsAsync();
    }

    private async Task HandleResetFilters()
    {
        _query.Search = null;
        _selectedCategoryIdString = "";
        _query.CategoryId = null;
        _query.MinPrice = null;
        _query.MaxPrice = null;
        _query.InStock = null;
        _query.Sort = "newest";
        _query.Page = 1;
        await LoadProductsAsync();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= _products.TotalPages)
        {
            _query.Page = newPage;
            await LoadProductsAsync();
        }
    }

    private void HandleStockChanged(StockChangedEvent ev)
    {
        InvokeAsync(() =>
        {
            var item = _products.Items.FirstOrDefault(p => p.Id == ev.ProductId);
            if (item != null)
            {
                item.StockQuantity = ev.StockQuantity;
                StateHasChanged();
            }
        });
    }

    private void HandleProductChanged(ProductChangedEvent ev)
    {
        InvokeAsync(async () =>
        {
            // When product changes or soft-deleted, reload catalog page
            await LoadProductsAsync();
        });
    }

    private async Task HandleAddToCart(Guid productId)
    {
        _isAddingToCart = true;
        _cartFeedbackMessage = null;
        StateHasChanged();

        var result = await CartClient.AddItemAsync(productId, 1);
        _isAddingToCart = false;

        if (result.Succeeded)
        {
            _justAddedProductId = productId;
            _cartFeedbackMessage = "Товар успешно добавлен в корзину.";
            _cartFeedbackIsError = false;
        }
        else
        {
            _cartFeedbackMessage = result.ErrorMessage ?? "Не удалось добавить товар в корзину.";
            _cartFeedbackIsError = true;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        RealtimeService.OnStockChanged -= HandleStockChanged;
        RealtimeService.OnProductChanged -= HandleProductChanged;
    }
}
