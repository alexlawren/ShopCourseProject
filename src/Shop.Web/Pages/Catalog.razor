@page "/catalog"
@inject ICatalogApiClient CatalogClient
@inject ICartApiClient CartClient
@inject ICatalogRealtimeService RealtimeService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Каталог товаров - ShopCourseProject</PageTitle>

<div class="container py-3 catalog-layout">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <h1 class="h3 fw-bold mb-0">Каталог товаров</h1>
        <RealtimeStatus Label="Каталог" GetState="() => RealtimeService.State" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_cartFeedbackMessage))
    {
        <div class="alert @(_cartFeedbackIsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 mb-3" role="alert">
            @_cartFeedbackMessage
            <button type="button" aria-label="Закрыть" class="btn-close" @onclick="() => _cartFeedbackMessage = null"></button>
        </div>
    }

    <!-- Фильтры -->
    <div class="card border-0 shadow-sm catalog-filters mb-4">
        <div class="catalog-filter-grid">
            <div class="filter-field">
                <label for="searchQuery" class="form-label">Поиск</label>
                <input id="searchQuery" type="text" class="form-control" placeholder="Название или описание..." @bind="_query.Search" />
            </div>

            <div class="filter-field">
                <label for="categoryFilter" class="form-label">Категория</label>
                <select id="categoryFilter" class="form-select" @bind="_selectedCategoryIdString">
                    <option value="">Все категории</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id.ToString()">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <label for="minPriceInput" class="form-label">Цена от (BYN)</label>
                <input id="minPriceInput" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" @bind="_query.MinPrice" />
            </div>

            <div class="filter-field">
                <label for="maxPriceInput" class="form-label">Цена до (BYN)</label>
                <input id="maxPriceInput" type="number" step="0.01" min="0" class="form-control" placeholder="99999.00" @bind="_query.MaxPrice" />
            </div>

            <div class="filter-field">
                <label for="sortFilter" class="form-label">Сортировка</label>
                <select id="sortFilter" class="form-select" @bind="_query.Sort">
                    <option value="newest">Сначала новые</option>
                    <option value="priceAsc">Сначала дешевле</option>
                    <option value="priceDesc">Сначала дороже</option>
                    <option value="nameAsc">По названию (А-Я)</option>
                    <option value="nameDesc">По названию (Я-А)</option>
                </select>
            </div>

            <div class="filter-footer d-flex flex-wrap gap-3 justify-content-between align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="inStockCheck" @bind="_query.InStock" />
                    <label class="form-check-label" for="inStockCheck">
                        Только в наличии
                    </label>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="HandleResetFilters">Сбросить</button>
                    <button type="button" class="btn btn-primary px-3" @onclick="HandleApplyFilters">Применить</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Список товаров -->
    @if (_isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-muted mt-2">Загрузка товаров...</p>
        </div>
    }
    else if (_loadError != null)
    {
        <div class="alert alert-danger" role="alert">@_loadError
            <button type="button" class="btn btn-outline-danger btn-sm ms-2" @onclick="ReloadCatalogAsync">Повторить</button>
        </div>
    }
    else if (_products.Items.Count == 0)
    {
        <div class="text-center my-5 py-5 bg-white rounded shadow-sm">
            <h4 class="text-muted">Товары не найдены</h4>
            <p class="text-muted small">Попробуйте изменить параметры поиска или фильтры.</p>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="HandleResetFilters">Сбросить фильтры</button>
        </div>
    }
    else
    {
        <div class="catalog-grid">
            @foreach (var prod in _products.Items)
            {
                <div class="product-cell" @key="prod.Id">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="product-img-container bg-light d-flex align-items-center justify-content-center p-2" >
                            <ProductImage Src="@CatalogClient.GetImageUrl(prod.ImagePath)" Alt="@prod.Name" />
                        </div>

                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary-subtle text-secondary category-badge align-self-start mb-2" title="@prod.CategoryName">
                                @(string.IsNullOrWhiteSpace(prod.CategoryName) ? "Без категории" : prod.CategoryName)
                            </span>
                            <h2 class="card-title fw-bold text-dark mb-3" title="@prod.Name">
                                <a href="/products/@prod.Id" class="text-decoration-none text-dark">
                                    @prod.Name
                                </a>
                            </h2>

                            <div class="mt-auto d-flex flex-wrap gap-2 justify-content-between align-items-center pt-2 border-top">
                                <div class="product-price fw-bold text-primary money">
                                    @MoneyDisplay.Format(prod.Price)
                                </div>
                                <div>
                                    @if (prod.StockQuantity > 0)
                                    {
                                        <span class="badge stock-badge @(prod.StockQuantity <= 5 ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success")" title="Количество на складе">
                                            @prod.StockQuantity шт.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge stock-badge bg-light text-secondary border">
                                            0 шт.
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="product-action mt-3">
                                <AuthorizeView>
                                    <Authorized>
                                        @if (prod.StockQuantity > 0)
                                        {
                                            <button type="button" class="btn btn-primary w-100" @onclick="() => HandleAddToCart(prod.Id)" disabled="@_isAddingToCart">
                                                @(_justAddedProductId == prod.Id ? "✓ Добавлено" : "В корзину")
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                                Нет в наличии
                                            </button>
                                        }
                                    </Authorized>
                                    <NotAuthorized>
                                        <a href="/login" class="btn btn-outline-secondary w-100">
                                            Войдите, чтобы купить
                                        </a>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Пагинация -->
        @if (_products.TotalPages > 1)
        {
            <div class="d-flex flex-wrap gap-2 justify-content-center align-items-center mt-5 gap-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_query.Page <= 1)" @onclick="() => ChangePage(_query.Page - 1)">
                    ← Назад
                </button>
                <span class="small text-muted">
                    Страница <strong>@_products.Page</strong> из <strong>@_products.TotalPages</strong> (всего: @_products.TotalItems)
                </span>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_query.Page >= _products.TotalPages)" @onclick="() => ChangePage(_query.Page + 1)">
                    Вперёд →
                </button>
            </div>
        }
    }
</div>

@code {
    private readonly CatalogQueryModel _query = new() { PageSize = 12 };
    private PagedResultDto<ProductListItemDto> _products = new();
    private IReadOnlyList<CategoryDto> _categories = [];
    private string _selectedCategoryIdString = "";
    private string? _loadError;
    private bool _isLoading = true;
    private bool _isAddingToCart = false;
    private Guid? _justAddedProductId;
    private string? _cartFeedbackMessage;
    private bool _cartFeedbackIsError;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to real-time events
        RealtimeService.OnStockChanged += HandleStockChanged;
        RealtimeService.OnProductChanged += HandleProductChanged;
        await RealtimeService.StartAsync();

        // Load categories and initial products
        try { _categories = await CatalogClient.GetCategoriesAsync(); }
        catch (Exception) { _loadError = "Не удалось загрузить категории. Повторите попытку."; }
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        if (Guid.TryParse(_selectedCategoryIdString, out var catId))
        {
            _query.CategoryId = catId;
        }
        else
        {
            _query.CategoryId = null;
        }

        try
        {
            _products = await CatalogClient.GetProductsAsync(_query);
        }
        catch (Exception)
        {
            _loadError = "Не удалось загрузить каталог. Проверьте соединение и параметры фильтров.";
        }
        finally { _isLoading = false; }
        StateHasChanged();
    }

    private async Task ReloadCatalogAsync()
    {
        _loadError = null;
        try { _categories = await CatalogClient.GetCategoriesAsync(); }
        catch (Exception) { _loadError = "Не удалось загрузить категории. Повторите попытку."; }
        await LoadProductsAsync();
    }

    private async Task HandleApplyFilters()
    {
        _loadError = null;
        _query.Page = 1;
        await LoadProductsAsync();
    }

    private async Task HandleResetFilters()
    {
        _query.Search = null;
        _selectedCategoryIdString = "";
        _query.CategoryId = null;
        _query.MinPrice = null;
        _query.MaxPrice = null;
        _query.InStock = null;
        _query.Sort = "newest";
        _loadError = null;
        _query.Page = 1;
        await LoadProductsAsync();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= _products.TotalPages)
        {
            _query.Page = newPage;
            await LoadProductsAsync();
        }
    }

    private void HandleStockChanged(StockChangedEvent ev)
    {
        InvokeAsync(() =>
        {
            var item = _products.Items.FirstOrDefault(p => p.Id == ev.ProductId);
            if (item != null)
            {
                item.StockQuantity = ev.StockQuantity;
                StateHasChanged();
            }
        });
    }

    private void HandleProductChanged(ProductChangedEvent ev)
    {
        InvokeAsync(async () =>
        {
            // When product changes or soft-deleted, reload catalog page
            await LoadProductsAsync();
        });
    }

    private async Task HandleAddToCart(Guid productId)
    {
        if (_isAddingToCart) return;
        _isAddingToCart = true;
        _cartFeedbackMessage = null;
        StateHasChanged();

        var result = await CartClient.AddItemAsync(productId, 1);
        _isAddingToCart = false;

        if (result.Succeeded)
        {
            _justAddedProductId = productId;
            _cartFeedbackMessage = "Товар успешно добавлен в корзину.";
            _cartFeedbackIsError = false;
        }
        else
        {
            _cartFeedbackMessage = result.ErrorMessage ?? "Не удалось добавить товар в корзину.";
            _cartFeedbackIsError = true;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        RealtimeService.OnStockChanged -= HandleStockChanged;
        RealtimeService.OnProductChanged -= HandleProductChanged;
    }
}
