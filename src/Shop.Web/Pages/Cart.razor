@page "/cart"
@attribute [Authorize]
@inject ICartApiClient CartClient
@inject ICatalogApiClient CatalogClient
@inject IOrderApiClient OrderClient
@inject ICheckoutRequestIdStorage RequestIdStorage
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Корзина - ShopCourseProject</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Корзина покупателя</h2>
        <a href="/catalog" class="btn btn-outline-secondary btn-sm">← Продолжить покупки</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <strong>Ошибка:</strong> @_errorMessage
                </div>
                @if (_canRetryCheckout)
                {
                    <button class="btn btn-danger btn-sm ms-3" @onclick="HandleCheckout" disabled="@_isCheckingOut">
                        Повторить попытку
                    </button>
                }
            </div>
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-muted mt-2">Загрузка корзины...</p>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-light">
            <div class="mb-3">
                <svg width="64" height="64" fill="currentColor" class="bi bi-cart-x text-muted" viewBox="0 0 16 16">
                    <path d="M7.354 5.646a.5.5 0 1 0-.708.708L7.793 7.5 6.646 8.646a.5.5 0 1 0 .708.708L8.5 8.207l1.146 1.147a.5.5 0 0 0 .708-.708L9.207 7.5l1.147-1.146a.5.5 0 0 0-.708-.708L8.5 6.793z"/>
                    <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zm3.915 10L3.102 4h10.796l-1.313 7zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                </svg>
            </div>
            <h4 class="fw-bold text-dark">Ваша корзина пуста</h4>
            <p class="text-muted">Выберите интересующие товары в каталоге и добавьте их в корзину.</p>
            <div class="mt-3">
                <a href="/catalog" class="btn btn-primary">Перейти в каталог</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Список товаров -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm overflow-hidden mb-3">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 80px;">Фото</th>
                                    <th scope="col">Товар</th>
                                    <th scope="col" style="width: 130px;">Цена</th>
                                    <th scope="col" style="width: 140px;">Количество</th>
                                    <th scope="col" style="width: 140px;">Сумма</th>
                                    <th scope="col" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _items)
                                {
                                    <tr @key="item.ProductId">
                                        <td>
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center p-1" style="width: 60px; height: 60px;">
                                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                                {
                                                    <img src="@CatalogClient.GetImageUrl(item.ImagePath)" class="img-fluid mh-100 rounded" alt="@item.ProductName" />
                                                }
                                                else
                                                {
                                                    <svg width="24" height="24" fill="currentColor" class="bi bi-image text-secondary" viewBox="0 0 16 16">
                                                        <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                                                        <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"/>
                                                    </svg>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.IsAvailable)
                                            {
                                                <a href="/products/@item.ProductId" class="fw-semibold text-decoration-none text-dark d-block">
                                                    @item.ProductName
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="fw-semibold text-danger">@item.ProductName</div>
                                                <span class="badge bg-danger-subtle text-danger small">Снят с продажи или не найден</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.UnitPrice.HasValue)
                                            {
                                                <span class="text-nowrap">@item.UnitPrice.Value.ToString("F2") ₽</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm" style="max-width: 120px;">
                                                <button class="btn btn-outline-secondary" type="button" @onclick="() => UpdateQuantity(item.ProductId, item.Quantity - 1)" disabled="@(item.Quantity <= 1 || _isUpdatingCart)">-</button>
                                                <input type="number" min="1" max="1000" class="form-control text-center px-1" value="@item.Quantity" @onchange="(e) => HandleQuantityInput(item.ProductId, e)" disabled="@_isUpdatingCart" />
                                                <button class="btn btn-outline-secondary" type="button" @onclick="() => UpdateQuantity(item.ProductId, item.Quantity + 1)" disabled="@(item.Quantity >= 1000 || _isUpdatingCart)">+</button>
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.LineTotal.HasValue)
                                            {
                                                <strong class="text-primary text-nowrap">@item.LineTotal.Value.ToString("F2") ₽</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-danger btn-sm border-0" title="Удалить из корзины" @onclick="() => RemoveItem(item.ProductId)" disabled="@_isUpdatingCart">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button class="btn btn-outline-danger btn-sm" @onclick="ClearCart" disabled="@(_isUpdatingCart || _isCheckingOut)">
                        Очистить корзину
                    </button>
                    <span class="text-muted small">Всего позиций: @_items.Count (товаров: @_items.Sum(i => i.Quantity))</span>
                </div>
            </div>

            <!-- Итоги и Оформление -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 bg-light">
                    <h5 class="fw-bold mb-3">Итог заказа</h5>

                    @if (_items.Any(i => !i.IsAvailable))
                    {
                        <div class="alert alert-warning small py-2 mb-3">
                            В корзине есть недоступные товары. Пожалуйста, удалите их для продолжения оформления.
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Предварительная сумма:</span>
                        <span class="fw-semibold">@_previewTotal.ToString("F2") ₽</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Доставка:</span>
                        <span class="text-success fw-semibold">Бесплатно</span>
                    </div>

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between align-items-baseline my-3">
                        <span class="fs-5 fw-bold text-dark">К оплате:</span>
                        <span class="fs-4 fw-bold text-primary">@_previewTotal.ToString("F2") ₽</span>
                    </div>

                    <div class="text-muted small mb-3">
                        <small>* Итоговая цена фиксируется сервисом заказа в момент подтверждения резервации.</small>
                    </div>

                    <button class="btn btn-primary btn-lg w-100 py-2 fw-semibold" @onclick="HandleCheckout" disabled="@(!CanCheckout || _isCheckingOut)">
                        @if (_isCheckingOut)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Оформление заказа...</span>
                        }
                        else
                        {
                            <span>Оформить заказ</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CartItemViewModel> _items = [];
    private decimal _previewTotal = 0m;
    private bool _isLoading = true;
    private bool _isUpdatingCart = false;
    private bool _isCheckingOut = false;
    private bool _canRetryCheckout = false;
    private string? _errorMessage;
    private string? _successMessage;

    private bool CanCheckout => _items.Count > 0 && _items.All(i => i.IsAvailable);

    protected override async Task OnInitializedAsync()
    {
        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var cart = await CartClient.GetCartAsync();
        if (cart == null || cart.Items.Count == 0)
        {
            _items = [];
            _previewTotal = 0m;
            _isLoading = false;
            StateHasChanged();
            return;
        }

        // Product enrichment: retrieve product details via CatalogApiClient
        var uniqueProductIds = cart.Items.Select(i => i.ProductId).Distinct().ToList();
        var productTasks = uniqueProductIds.Select(id => CatalogClient.GetProductByIdAsync(id));
        var loadedProducts = await Task.WhenAll(productTasks);
        var productMap = loadedProducts.Where(p => p != null).ToDictionary(p => p!.Id, p => p!);

        var enrichedList = new List<CartItemViewModel>();
        foreach (var cartItem in cart.Items)
        {
            if (productMap.TryGetValue(cartItem.ProductId, out var catalogProd) && catalogProd != null)
            {
                enrichedList.Add(new CartItemViewModel
                {
                    ProductId = cartItem.ProductId,
                    Quantity = cartItem.Quantity,
                    ProductName = catalogProd.Name,
                    UnitPrice = catalogProd.Price,
                    ImagePath = catalogProd.ImagePath,
                    IsAvailable = true
                });
            }
            else
            {
                enrichedList.Add(new CartItemViewModel
                {
                    ProductId = cartItem.ProductId,
                    Quantity = cartItem.Quantity,
                    ProductName = "Товар недоступен",
                    UnitPrice = null,
                    ImagePath = null,
                    IsAvailable = false
                });
            }
        }

        _items = enrichedList;
        _previewTotal = CartTotalHelper.CalculatePreviewTotal(_items);
        _isLoading = false;
        StateHasChanged();
    }

    private async Task UpdateQuantity(Guid productId, int newQuantity)
    {
        if (newQuantity < 1)
        {
            await RemoveItem(productId);
            return;
        }

        if (newQuantity > 1000)
        {
            _errorMessage = "Количество товара не может превышать 1000.";
            return;
        }

        _isUpdatingCart = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await CartClient.UpdateItemAsync(productId, newQuantity);
        _isUpdatingCart = false;

        if (result.Succeeded)
        {
            await LoadCartAsync();
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Не удалось обновить количество товара.";
            StateHasChanged();
        }
    }

    private async Task HandleQuantityInput(Guid productId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty))
        {
            await UpdateQuantity(productId, qty);
        }
        else
        {
            _errorMessage = "Некорректное значение количества.";
            StateHasChanged();
        }
    }

    private async Task RemoveItem(Guid productId)
    {
        _isUpdatingCart = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await CartClient.RemoveItemAsync(productId);
        _isUpdatingCart = false;

        if (result.Succeeded)
        {
            await LoadCartAsync();
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Не удалось удалить товар из корзины.";
            StateHasChanged();
        }
    }

    private async Task ClearCart()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Вы действительно хотите полностью очистить корзину?");
        if (!confirmed)
            return;

        _isUpdatingCart = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await CartClient.ClearAsync();
        _isUpdatingCart = false;

        if (result.Succeeded)
        {
            _items.Clear();
            _previewTotal = 0m;
            StateHasChanged();
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Не удалось очистить корзину.";
            StateHasChanged();
        }
    }

    private async Task HandleCheckout()
    {
        if (!CanCheckout || _isCheckingOut)
            return;

        _isCheckingOut = true;
        _errorMessage = null;
        _canRetryCheckout = false;
        StateHasChanged();

        // 1. Get or create idempotent pending RequestId
        var pendingId = await RequestIdStorage.GetPendingRequestIdAsync();
        if (!pendingId.HasValue)
        {
            pendingId = Guid.NewGuid();
            await RequestIdStorage.SetPendingRequestIdAsync(pendingId.Value);
        }

        var result = await OrderClient.CheckoutAsync(pendingId.Value);
        _isCheckingOut = false;

        if (result.Succeeded && result.Value != null)
        {
            // Success: clear pending RequestId
            await RequestIdStorage.ClearPendingRequestIdAsync();
            Navigation.NavigateTo($"/orders/{result.Value.Id}");
            return;
        }

        // Failure handling
        _errorMessage = result.ErrorMessage ?? "Произошла ошибка при оформлении заказа.";

        if (CheckoutIdempotencyHelper.ShouldClearRequestIdOnFailure(result.StatusCode, result.ErrorCode))
        {
            // Deterministic failure: clear pending RequestId
            await RequestIdStorage.ClearPendingRequestIdAsync();
            _canRetryCheckout = false;
        }
        else
        {
            // Uncertain downstream / network failure: PRESERVE RequestId for retry
            _canRetryCheckout = true;
        }

        // Refresh cart in case of partial modifications
        await LoadCartAsync();
    }
}
