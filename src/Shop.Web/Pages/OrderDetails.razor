@page "/orders/{Id:guid}"
@attribute [Authorize]
@inject IOrderApiClient OrderClient
@inject ICatalogApiClient CatalogClient
@inject IOrderRealtimeService OrderRealtime
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Детали заказа - ShopCourseProject</PageTitle>

<div class="container py-4">
    <div class="mb-3">
        <a href="/orders" class="text-decoration-none text-muted small">
            ← Вернуться к списку заказов
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <strong>Ошибка:</strong> @_errorMessage
                </div>
                @if (_canRetryCancellation)
                {
                    <button class="btn btn-danger btn-sm ms-3" @onclick="HandleCancel" disabled="@_isProcessing">
                        Повторить отмену
                    </button>
                }
            </div>
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_infoMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @_infoMessage
            <button type="button" class="btn-close" @onclick="() => _infoMessage = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-muted mt-2">Загрузка деталей заказа...</p>
        </div>
    }
    else if (_order == null)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-light">
            <h3 class="text-danger fw-bold">Заказ не найден</h3>
            <p class="text-muted">Запрошенный заказ не существует, либо принадлежит другому пользователю.</p>
            <div class="mt-3">
                <a href="/orders" class="btn btn-primary">К моим заказам</a>
            </div>
        </div>
    }
    else
    {
        <!-- Заголовок заказа -->
        <div class="card border-0 shadow-sm p-4 mb-4 bg-light">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h3 class="fw-bold mb-1">
                        Заказ <span class="font-monospace text-primary">#@_order.Id.ToString()[..8]</span>
                    </h3>
                    <div class="text-muted small">
                        Оформлен: @_order.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                        @if (_order.UpdatedAtUtc != _order.CreatedAtUtc)
                        {
                            <span class="ms-2">| Изменён: @_order.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-center">
                    <span class="@OrderUiHelper.GetStatusBadgeClass(_order.Status) fs-6 px-3 py-2">
                        @OrderUiHelper.GetStatusDisplayName(_order.Status)
                    </span>
                    <span class="@OrderUiHelper.GetPaymentStatusBadgeClass(_order.PaymentStatus) fs-6 px-3 py-2">
                        @OrderUiHelper.GetPaymentStatusDisplayName(_order.PaymentStatus)
                    </span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Состав заказа -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm overflow-hidden mb-4">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0">Состав заказа</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 70px;">Фото</th>
                                    <th scope="col">Наименование (снимок)</th>
                                    <th scope="col" style="width: 120px;">Цена за шт.</th>
                                    <th scope="col" style="width: 100px;">Кол-во</th>
                                    <th scope="col" style="width: 130px;" class="text-end">Сумма</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _order.Items)
                                {
                                    <tr @key="item.ProductId">
                                        <td>
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center p-1" style="width: 50px; height: 50px;">
                                                @if (_productImages.TryGetValue(item.ProductId, out var imgUrl) && !string.IsNullOrWhiteSpace(imgUrl))
                                                {
                                                    <img src="@imgUrl" class="img-fluid mh-100 rounded" alt="@item.ProductName" />
                                                }
                                                else
                                                {
                                                    <svg width="20" height="20" fill="currentColor" class="bi bi-image text-secondary" viewBox="0 0 16 16">
                                                        <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                                                        <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"/>
                                                    </svg>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark">@item.ProductName</span>
                                            <div class="text-muted small">ID: @item.ProductId</div>
                                        </td>
                                        <td>
                                            <span class="text-nowrap">@item.UnitPrice.ToString("F2") ₽</span>
                                        </td>
                                        <td>
                                            <span>@item.Quantity шт.</span>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-primary text-nowrap">@item.LineTotal.ToString("F2") ₽</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="fw-bold text-end">Итого к оплате:</td>
                                    <td class="text-end">
                                        <span class="fs-5 fw-bold text-primary text-nowrap">@_order.TotalAmount.ToString("F2") ₽</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- История изменения статусов -->
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-3">История изменения статуса</h5>
                    @if (_order.StatusHistory.Count == 0)
                    {
                        <p class="text-muted small mb-0">История статусов отсутствует.</p>
                    }
                    else
                    {
                        <div class="timeline">
                            @foreach (var history in _order.StatusHistory.OrderBy(h => h.ChangedAtUtc))
                            {
                                <div class="d-flex align-items-center mb-2 pb-2 border-bottom">
                                    <span class="@OrderUiHelper.GetStatusBadgeClass(history.Status) me-3" style="min-width: 100px;">
                                        @OrderUiHelper.GetStatusDisplayName(history.Status)
                                    </span>
                                    <span class="text-muted small">
                                        @history.ChangedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Боковая панель действий: Оплата / Отмена -->
            <div class="col-lg-4">
                <!-- Оплата (симуляция) -->
                @if (_order.PaymentStatus == "Pending" && _order.Status != "Cancelled")
                {
                    <div class="card border-0 shadow-sm p-4 mb-4 bg-light">
                        <h5 class="fw-bold mb-2">Оплата заказа</h5>
                        <p class="text-muted small mb-3">
                            Заказ ожидает оплаты. Для перехода в статус «Подтверждён» выполните симуляцию оплаты.
                        </p>

                        <button class="btn btn-success btn-lg w-100 py-2 fw-semibold mb-2" @onclick="HandlePay" disabled="@_isProcessing">
                            @if (_isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Обработка...</span>
                            }
                            else
                            {
                                <span>Оплатить (симуляция)</span>
                            }
                        </button>

                        <div class="alert alert-warning py-2 px-3 mb-0 small border-0 bg-warning-subtle text-dark">
                            <strong>Обратите внимание:</strong> Учебная симуляция оплаты — реальные денежные средства не списываются.
                        </div>
                    </div>
                }

                <!-- Отмена заказа -->
                @if (OrderUiHelper.CanCancel(_order.Status))
                {
                    <div class="card border-0 shadow-sm p-4 bg-light">
                        <h5 class="fw-bold mb-2 text-danger">Отмена заказа</h5>
                        <p class="text-muted small mb-3">
                            Вы можете отменить заказ, пока он не передан в доставку (статусы «Создан», «Подтверждён», «В обработке»).
                        </p>

                        <button class="btn btn-outline-danger w-100 py-2 fw-semibold" @onclick="HandleCancel" disabled="@_isProcessing">
                            @if (_isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Отмена заказа...</span>
                            }
                            else
                            {
                                <span>Отменить заказ</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private OrderDetailsDto? _order;
    private Dictionary<Guid, string?> _productImages = new();
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private bool _canRetryCancellation = false;
    private string? _errorMessage;
    private string? _infoMessage;

    protected override async Task OnInitializedAsync()
    {
        OrderRealtime.OnOrderStatusChanged += HandleOrderStatusChanged;
        OrderRealtime.OnPaymentStatusChanged += HandlePaymentStatusChanged;

        await OrderRealtime.StartAsync();
        await LoadOrderDetailsAsync();
    }

    private async Task LoadOrderDetailsAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        _order = await OrderClient.GetOrderAsync(Id);
        _isLoading = false;

        if (_order != null)
        {
            // Optionally load product images from catalog for nicer preview (non-blocking)
            _ = LoadProductImagesAsync(_order.Items.Select(i => i.ProductId).Distinct());
        }

        StateHasChanged();
    }

    private async Task LoadProductImagesAsync(IEnumerable<Guid> productIds)
    {
        try
        {
            var tasks = productIds.Select(async pid =>
            {
                var p = await CatalogClient.GetProductByIdAsync(pid);
                return (pid, img: p?.ImagePath != null ? CatalogClient.GetImageUrl(p.ImagePath) : null);
            });

            var results = await Task.WhenAll(tasks);
            _productImages = results.ToDictionary(r => r.pid, r => r.img);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Ignore catalog image preview load errors
        }
    }

    private async Task HandlePay()
    {
        if (_order == null || _isProcessing)
            return;

        _isProcessing = true;
        _errorMessage = null;
        _infoMessage = null;
        StateHasChanged();

        var result = await OrderClient.PayAsync(Id);
        _isProcessing = false;

        if (result.Succeeded && result.Value != null)
        {
            _order = result.Value;
            _infoMessage = "Оплата успешно выполнена (симуляция). Статус заказа обновлён.";
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Не удалось выполнить оплату заказа.";
        }

        StateHasChanged();
    }

    private async Task HandleCancel()
    {
        if (_order == null || _isProcessing)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Вы действительно хотите отменить этот заказ?");
        if (!confirmed)
            return;

        _isProcessing = true;
        _errorMessage = null;
        _infoMessage = null;
        _canRetryCancellation = false;
        StateHasChanged();

        var result = await OrderClient.CancelAsync(Id);
        _isProcessing = false;

        if (result.Succeeded && result.Value != null)
        {
            _order = result.Value;
            _infoMessage = "Заказ успешно отменён.";
            _canRetryCancellation = false;
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Не удалось отменить заказ.";
            if (string.Equals(result.ErrorCode, "ORDER_CANCELLATION_IN_PROGRESS", StringComparison.OrdinalIgnoreCase) ||
                result.StatusCode == 503 || result.StatusCode == 502)
            {
                _canRetryCancellation = true;
            }
        }

        StateHasChanged();
    }

    private void HandleOrderStatusChanged(OrderStatusChangedEvent ev)
    {
        if (ev.OrderId == Id)
        {
            InvokeAsync(async () =>
            {
                // Refetch full order details to receive updated status and status history
                await LoadOrderDetailsAsync();
            });
        }
    }

    private void HandlePaymentStatusChanged(PaymentStatusChangedEvent ev)
    {
        if (ev.OrderId == Id)
        {
            InvokeAsync(async () =>
            {
                // Refetch full order details to receive updated payment status and status history
                await LoadOrderDetailsAsync();
            });
        }
    }

    public void Dispose()
    {
        OrderRealtime.OnOrderStatusChanged -= HandleOrderStatusChanged;
        OrderRealtime.OnPaymentStatusChanged -= HandlePaymentStatusChanged;
    }
}
