@page "/orders"
@attribute [Authorize]
@inject IOrderApiClient OrderClient
@inject IOrderRealtimeService OrderRealtime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Мои заказы - ShopCourseProject</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Мои заказы</h2>
        <span class="badge bg-light text-dark border">
            Статус уведомлений:
            @if (OrderRealtime.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
            {
                <span class="text-success fw-bold">● Подключено</span>
            }
            else
            {
                <span class="text-muted">Подключение...</span>
            }
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-muted mt-2">Загрузка списка заказов...</p>
        </div>
    }
    else if (_ordersResult == null || _ordersResult.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-light">
            <div class="mb-3">
                <svg width="64" height="64" fill="currentColor" class="bi bi-box-seam text-muted" viewBox="0 0 16 16">
                    <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2l-2.218-.887zm3.564 1.426L5.596 5 8 5.961 14.154 3.5l-2.404-.961zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923l6.5 2.6zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464L7.443.184z"/>
                </svg>
            </div>
            <h4 class="fw-bold text-dark">У вас пока нет заказов</h4>
            <p class="text-muted">Оформите ваш первый заказ через каталог товаров.</p>
            <div class="mt-3">
                <a href="/catalog" class="btn btn-primary">Перейти в каталог</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Номер заказа</th>
                            <th scope="col">Дата</th>
                            <th scope="col">Статус заказа</th>
                            <th scope="col">Оплата</th>
                            <th scope="col">Сумма</th>
                            <th scope="col" class="text-end">Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _orders)
                        {
                            <tr @key="order.Id">
                                <td>
                                    <span class="fw-semibold font-monospace" title="@order.Id">
                                        #@order.Id.ToString()[..8]
                                    </span>
                                </td>
                                <td>
                                    @order.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="@OrderUiHelper.GetStatusBadgeClass(order.Status)">
                                        @OrderUiHelper.GetStatusDisplayName(order.Status)
                                    </span>
                                </td>
                                <td>
                                    <span class="@OrderUiHelper.GetPaymentStatusBadgeClass(order.PaymentStatus)">
                                        @OrderUiHelper.GetPaymentStatusDisplayName(order.PaymentStatus)
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-primary">@order.TotalAmount.ToString("F2") ₽</strong>
                                </td>
                                <td class="text-end">
                                    <a href="/orders/@order.Id" class="btn btn-outline-primary btn-sm">
                                        Подробнее →
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_ordersResult.TotalPages > 1)
        {
            <div class="d-flex justify-content-center align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm" disabled="@(_currentPage <= 1 || _isLoading)" @onclick="() => ChangePage(_currentPage - 1)">
                    ← Назад
                </button>
                <span class="small text-muted">
                    Страница <strong>@_currentPage</strong> из <strong>@_ordersResult.TotalPages</strong> (всего: @_ordersResult.TotalCount)
                </span>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(_currentPage >= _ordersResult.TotalPages || _isLoading)" @onclick="() => ChangePage(_currentPage + 1)">
                    Вперёд →
                </button>
            </div>
        }
    }
</div>

@code {
    private PagedResult<OrderListItemDto>? _ordersResult;
    private List<OrderListItemDto> _orders = [];
    private int _currentPage = 1;
    private const int PageSize = 10;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        OrderRealtime.OnOrderCreated += HandleOrderCreated;
        OrderRealtime.OnOrderStatusChanged += HandleOrderStatusChanged;
        OrderRealtime.OnPaymentStatusChanged += HandlePaymentStatusChanged;

        await OrderRealtime.StartAsync();
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        var result = await OrderClient.GetOrdersAsync(_currentPage, PageSize);
        _isLoading = false;

        if (result != null)
        {
            _ordersResult = result;
            _orders = result.Items.ToList();
        }
        else
        {
            _errorMessage = "Не удалось загрузить список заказов.";
        }

        StateHasChanged();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && (_ordersResult == null || newPage <= _ordersResult.TotalPages))
        {
            _currentPage = newPage;
            await LoadOrdersAsync();
        }
    }

    private void HandleOrderCreated(OrderCreatedEvent ev)
    {
        InvokeAsync(async () =>
        {
            // Reload current page to include newly created order
            await LoadOrdersAsync();
        });
    }

    private void HandleOrderStatusChanged(OrderStatusChangedEvent ev)
    {
        InvokeAsync(() =>
        {
            if (OrderEventApplier.ApplyStatusChanged(_orders, ev))
            {
                StateHasChanged();
            }
        });
    }

    private void HandlePaymentStatusChanged(PaymentStatusChangedEvent ev)
    {
        InvokeAsync(() =>
        {
            if (OrderEventApplier.ApplyPaymentStatusChanged(_orders, ev))
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        OrderRealtime.OnOrderCreated -= HandleOrderCreated;
        OrderRealtime.OnOrderStatusChanged -= HandleOrderStatusChanged;
        OrderRealtime.OnPaymentStatusChanged -= HandlePaymentStatusChanged;
    }
}
