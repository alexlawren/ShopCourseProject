@page "/products/{Id:guid}"
@inject ICatalogApiClient CatalogClient
@inject ICatalogRealtimeService RealtimeService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(_product?.Name ?? "Детали товара") - ShopCourseProject</PageTitle>

<div class="container py-4">
    <div class="mb-3">
        <a href="/catalog" class="text-decoration-none text-muted small">
            ← Вернуться в каталог
        </a>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5 py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="text-muted mt-2">Загрузка информации о товаре...</p>
        </div>
    }
    else if (_product == null)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-light">
            <h3 class="text-danger fw-bold">Товар не найден</h3>
            <p class="text-muted">Запрошенный товар не существует, либо был снят с продажи.</p>
            <div class="mt-3">
                <a href="/catalog" class="btn btn-primary">Перейти в каталог</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-5">
            <!-- Изображение -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4 bg-light d-flex align-items-center justify-content-center" style="min-height: 380px;">
                    @if (!string.IsNullOrWhiteSpace(_product.ImagePath))
                    {
                        <img src="@CatalogClient.GetImageUrl(_product.ImagePath)" class="img-fluid rounded shadow-sm" alt="@_product.Name" style="max-height: 360px;" />
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <svg width="80" height="80" fill="currentColor" class="bi bi-image text-secondary" viewBox="0 0 16 16">
                                <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
                                <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"/>
                            </svg>
                            <div class="mt-2">Изображение отсутствует</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Информация о товаре -->
            <div class="col-md-6 d-flex flex-column">
                @if (_product.Category != null)
                {
                    <span class="badge bg-secondary-subtle text-secondary align-self-start mb-2">
                        @_product.Category.Name
                    </span>
                }

                <h2 class="fw-bold mb-3">@_product.Name</h2>

                <div class="mb-4">
                    <span class="display-6 fw-bold text-primary">@_product.Price.ToString("F2") ₽</span>
                </div>

                <div class="mb-4">
                    <h6 class="fw-semibold text-muted text-uppercase small">Наличие на складе</h6>
                    @if (_product.StockQuantity > 0)
                    {
                        <span class="badge bg-success-subtle text-success fs-6 border border-success-subtle px-3 py-2">
                            В наличии: @_product.StockQuantity шт.
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger fs-6 border border-danger-subtle px-3 py-2">
                            Нет в наличии
                        </span>
                    }
                </div>

                <div class="mb-4 flex-grow-1">
                    <h6 class="fw-semibold text-muted text-uppercase small">Описание</h6>
                    <p class="text-secondary lh-base">
                        @(string.IsNullOrWhiteSpace(_product.Description) ? "Описание не указано производителем." : _product.Description)
                    </p>
                </div>

                <div class="border-top pt-3 text-muted small">
                    Добавлен: @_product.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProductDetailDto? _product;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        RealtimeService.OnStockChanged += HandleStockChanged;
        RealtimeService.OnProductChanged += HandleProductChanged;
        await RealtimeService.StartAsync();

        await LoadProductAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        _isLoading = true;
        StateHasChanged();

        _product = await CatalogClient.GetProductByIdAsync(Id);
        _isLoading = false;
        StateHasChanged();
    }

    private void HandleStockChanged(StockChangedEvent ev)
    {
        if (_product != null && _product.Id == ev.ProductId)
        {
            InvokeAsync(() =>
            {
                _product.StockQuantity = ev.StockQuantity;
                StateHasChanged();
            });
        }
    }

    private void HandleProductChanged(ProductChangedEvent ev)
    {
        if (ev.ProductId == Id)
        {
            InvokeAsync(async () =>
            {
                await LoadProductAsync();
            });
        }
    }

    public void Dispose()
    {
        RealtimeService.OnStockChanged -= HandleStockChanged;
        RealtimeService.OnProductChanged -= HandleProductChanged;
    }
}
