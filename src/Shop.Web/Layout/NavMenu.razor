@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="shop-brand navbar navbar-dark">
    <a class="brand-link" href="/" @onclick="() => _menuOpen = false">
        <span class="brand-mark" aria-hidden="true">
            <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 7h14l1 14H4L5 7zM8 8V6a4 4 0 0 1 8 0v2" />
            </svg>
        </span>
        <span><span class="brand-name">ShopCourseProject</span><span class="brand-caption">Интернет-магазин</span></span>
    </a>
    <button type="button" class="navbar-toggler" aria-label="Меню навигации"
            aria-expanded="@_menuOpen.ToString().ToLowerInvariant()" aria-controls="shopNavigation"
            @onclick="() => _menuOpen = !_menuOpen">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div id="shopNavigation" class="nav-scrollable @(_menuOpen ? "menu-open" : "")">
    <nav class="nav-content" aria-label="Основная навигация" @onclick="() => _menuOpen = false">
        <div class="nav-group">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><NavIcon Kind="home" /> Главная</NavLink>
            <NavLink class="nav-link" href="catalog"><NavIcon Kind="catalog" /> Каталог</NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-group">
                    <NavLink class="nav-link" href="cart"><NavIcon Kind="cart" /> Корзина</NavLink>
                    <NavLink class="nav-link" href="orders"><NavIcon Kind="orders" /> Мои заказы</NavLink>
                </div>
                <AuthorizeView Roles="Admin" Context="adminContext">
                    <div class="nav-group admin-group">
                        <div class="nav-section">Администрирование</div>
                        <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All"><NavIcon Kind="admin" /> Панель</NavLink>
                        <NavLink class="nav-link" href="admin/catalog"><NavIcon Kind="catalog" /> Каталог</NavLink>
                        <NavLink class="nav-link" href="admin/orders"><NavIcon Kind="orders" /> Заказы</NavLink>
                    </div>
                </AuthorizeView>
                <div class="account-section">
                    <div class="account-label">Ваш аккаунт</div>
                    <div class="account-email" title="@context.User.Identity?.Name">@context.User.Identity?.Name</div>
                    @if (context.User.IsInRole("Admin"))
                    {
                        <span class="account-role">Администратор</span>
                    }
                    else
                    {
                        <span class="account-role">Покупатель</span>
                    }
                    <button type="button" class="btn btn-outline-light w-100 mt-3" @onclick="HandleLogout">Выйти</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="account-section">
                    <NavLink class="nav-link" href="login"><NavIcon Kind="login" /> Вход</NavLink>
                    <NavLink class="nav-link" href="register"><NavIcon Kind="register" /> Регистрация</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool _menuOpen;
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
