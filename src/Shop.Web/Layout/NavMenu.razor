@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">ShopCourseProject</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Главная
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog">
                Каталог
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cart">
                        Корзина
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        Мои заказы
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="adminContext">
                    <div class="px-3 pt-2 text-uppercase text-light fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em; opacity: 0.7;">
                        Администрирование
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                            Панель
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/catalog">
                            Каталог (Admin)
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/orders">
                            Заказы (Admin)
                        </NavLink>
                    </div>
                </AuthorizeView>
                <div class="px-3 pt-3 text-muted border-top mt-2 small">
                    <div class="text-white fw-semibold text-truncate">@context.User.Identity?.Name</div>
                    @if (context.User.IsInRole("Admin"))
                    {
                        <span class="badge bg-danger mt-1">Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mt-1">Customer</span>
                    }
                </div>
                <div class="nav-item px-3 mt-2">
                    <button class="btn btn-outline-light btn-sm w-100" @onclick="HandleLogout">
                        Выйти
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3 mt-3 border-top pt-3">
                    <NavLink class="nav-link" href="login">
                        Вход
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        Регистрация
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
