@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">ShopCourseProject</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Главная
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog">
                Каталог
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cart">
                        Корзина
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        Мои заказы
                    </NavLink>
                </div>
                <div class="px-3 pt-3 text-muted border-top mt-2 small">
                    <div class="text-white fw-semibold text-truncate">@context.User.Identity?.Name</div>
                    @if (context.User.IsInRole("Admin"))
                    {
                        <span class="badge bg-danger mt-1">Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mt-1">Customer</span>
                    }
                </div>
                <div class="nav-item px-3 mt-2">
                    <button class="btn btn-outline-light btn-sm w-100" @onclick="HandleLogout">
                        Выйти
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3 mt-3 border-top pt-3">
                    <NavLink class="nav-link" href="login">
                        Вход
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        Регистрация
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
