@inherits LayoutComponentBase

<div class="page">
    <a class="skip-link visually-hidden-focusable" href="#main-content">Перейти к содержимому</a>
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="header-inner">
                <span class="header-caption">Интернет-магазин ShopCourseProject</span>
                <span class="status-chip status-chip-neutral" title="Запросы приложения проходят через Gateway">
                    <span class="status-dot" aria-hidden="true"></span> API · Gateway
                </span>
            </div>
        </div>

        <article id="main-content" tabindex="-1" class="content">
            @Body
        </article>
    </main>
</div>
