@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<span class="status-chip @StatusClass" title="@($"{Label}: {StatusText}. SignalR / WebSocket")">
    <span class="status-dot" aria-hidden="true"></span>
    <span>@Label · @StatusText</span>
</span>

@code {
    [Parameter] public string Label { get; set; } = "Realtime";
    [Parameter, EditorRequired] public Func<HubConnectionState> GetState { get; set; } = () => HubConnectionState.Disconnected;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _observeTask;
    private HubConnectionState _state;

    private string StatusClass => _state switch
    {
        HubConnectionState.Connected => "status-chip-connected",
        HubConnectionState.Connecting or HubConnectionState.Reconnecting => "status-chip-connecting",
        _ => "status-chip-disconnected"
    };
    private string StatusText => _state switch
    {
        HubConnectionState.Connected => "подключено",
        HubConnectionState.Connecting => "подключение",
        HubConnectionState.Reconnecting => "переподключение",
        _ => "отключено"
    };

    protected override void OnParametersSet() => _state = GetState();
    protected override void OnInitialized() => _observeTask = ObserveDisplayStateAsync();

    // Read state for display only; connection/reconnect semantics stay in the service.
    private async Task ObserveDisplayStateAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                await InvokeAsync(() =>
                {
                    var current = GetState();
                    if (current == _state) return;
                    _state = current;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        if (_observeTask != null) await _observeTask;
        _lifetime.Dispose();
    }
}
