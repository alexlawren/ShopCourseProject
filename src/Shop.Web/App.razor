<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="routeContext">
                    <div class="status-page">
                        <PageTitle>Доступ ограничен</PageTitle>
                        <h1 class="h3">Доступ ограничен</h1>
                        <AuthorizeView Context="authContext">
                            <Authorized>
                                <p class="text-danger">У вас нет прав администратора для просмотра этой страницы.</p>
                                <a href="/" class="btn btn-outline-primary">На главную</a>
                            </Authorized>
                            <NotAuthorized Context="anonContext">
                                <p class="text-muted">Пожалуйста, войдите в систему для доступа к этой странице.</p>
                                <a href="/login" class="btn btn-primary">Войти</a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Страница не найдена</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="status-page">
                    <h1 class="h3">Страница не найдена</h1>
                    <p class="text-muted">Запрошенная страница не существует.</p>
                    <a href="/" class="btn btn-outline-primary">На главную</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
